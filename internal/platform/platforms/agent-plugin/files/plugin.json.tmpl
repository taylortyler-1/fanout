{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": {{ json .Plugin.Name }},
  "version": {{ json .Plugin.Version }}
{{- with .Plugin.Description }},
  "description": {{ json . }}
{{- end }}
{{- $author := .Plugin.Author }}
{{- if or $author.Name $author.Email $author.URL }},
  "author": {
{{- $sep := "" }}
{{- with $author.Name }}{{ $sep }}
    "name": {{ json . }}
{{- $sep = "," }}
{{- end }}
{{- with $author.Email }}{{ $sep }}
    "email": {{ json . }}
{{- $sep = "," }}
{{- end }}
{{- with $author.URL }}{{ $sep }}
    "url": {{ json . }}
{{- $sep = "," }}
{{- end }}
  }
{{- end }}
{{- with .Plugin.Homepage }},
  "homepage": {{ json . }}
{{- end }}
{{- with .Plugin.Repository }},
  "repository": {{ json . }}
{{- end }}
{{- with .Plugin.License }},
  "license": {{ json . }}
{{- end }}
{{- with .Plugin.Keywords }},
  "keywords": {{ json . }}
{{- end }}
}
